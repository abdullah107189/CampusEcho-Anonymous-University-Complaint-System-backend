 
generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(staff)
  isActive  Boolean  @default(false)
  isVerified Boolean @default(false)
  otp       String?
  otpExpiry DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  assignedComplaints Complaint[] @relation("AssignedTo")
  notes              Note[]      @relation("AddedBy")
  statusChanges      StatusHistory[] @relation("ChangedBy")
  
  @@map("users")
}

model Complaint {
  id           String   @id @default(cuid())
  trackingId   String   @unique
  title        String
  description  String
  category     Category
  status       Status   @default(Pending)
  priority     Priority @default(Medium)
  attachment   String?
  assignedToId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  assignedTo   User?            @relation("AssignedTo", fields: [assignedToId], references: [id])
  notes        Note[]
  statusHistory StatusHistory[]
  
  @@index([trackingId])
  @@index([status])
  @@index([category])
  @@map("complaints")
}

model Note {
  id          String   @id @default(cuid())
  content     String
  complaintId String
  addedById   String
  createdAt   DateTime @default(now())
  
  complaint   Complaint @relation(fields: [complaintId], references: [id])
  addedBy     User      @relation("AddedBy", fields: [addedById], references: [id])
  
  @@map("notes")
}

model StatusHistory {
  id          String   @id @default(cuid())
  status      Status
  complaintId String
  changedById String
  changedAt   DateTime @default(now())
  
  complaint   Complaint @relation(fields: [complaintId], references: [id])
  changedBy   User      @relation("ChangedBy", fields: [changedById], references: [id])
  
  @@map("status_history")
}

enum Role {
  admin
  staff
}

enum Category {
  Academic
  Facilities
  Administrative
  Hostel
  Transport
  IT_Services
  Library
  Sports
  Cafeteria
  Other
}

enum Status {
  Pending
  Under_Review
  Investigating
  Resolved
  Rejected
}

enum Priority {
  Low
  Medium
  High
  Urgent
}